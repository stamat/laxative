{
  "styles": [{
    "in": "node_modules/poops-docs-theme/scss/docs.scss",
    "out": "docs/dist/css/docs.css",
    "options": { "minify": true, "justMinified": true }
  }],
  "scripts": [{
    "in": "node_modules/poops-docs-theme/src/docs.ts",
    "out": "docs/dist/js/docs.js",
    "options": { "minify": true, "justMinified": true, "format": "iife", "target": "es2019" }
  }],
  "markup": {
    "in": "docs/src/markup",
    "out": "docs/dist",
    "options": {
      "site": {
        "title": "laxative",
        "brand": "laxative",
        "brandMark": "💊",
        "description": "One config, whole stack: conducts poops (frontend) and septic (backend) into one MVP.",
        "url": "https://stamat.github.io/laxative",
        "repo": "https://github.com/stamat/laxative",
        "branch": "main",
        "lang": "en",
        "links": [
          { "title": "GitHub", "url": "https://github.com/stamat/laxative" },
          { "title": "septic", "url": "https://github.com/stamat/septic" },
          { "title": "poops", "url": "https://github.com/stamat/poops" }
        ],
        "iconLinks": [
          { "title": "GitHub", "url": "https://github.com/stamat/laxative", "icon": "github" }
        ]
      },
      "searchIndex": "search-index.json",
      "sitemap": "sitemap.xml",
      "robots": "robots.txt",
      "nav": { "out": "nav.json", "root": "docs" }
    }
  },
  "serve": { "port": 4043, "base": "docs/dist" },
  "livereload": true,
  "watch": ["docs/src"],
  "includePaths": ["node_modules"]
}
